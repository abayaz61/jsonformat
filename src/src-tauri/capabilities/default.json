{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "JSON Formatter için varsayılan izinler",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}